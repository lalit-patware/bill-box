# Public values only (shipped to the browser). Never put the service role key here.
VITE_SUPABASE_URL=
# Supabase publishable/anon key (safe for browsers; RLS protects data)
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
# Web Push public key (pairs with VAPID_PRIVATE_KEY on the API)
VITE_VAPID_PUBLIC_KEY=
