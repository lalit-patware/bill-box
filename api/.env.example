# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Upload limits
MAX_UPLOAD_MB=5
MAX_FILES_LIVE=3

# Optional tracing (leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Where batch job state is stored until Supabase lands in Phase 2
BATCH_STORE_PATH=.data/batches.json

# INR per USD, used only for cost reports
USD_TO_INR=88

# Supabase (server-only; never put the service role key in the PWA)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy HS256 JWT secret; leave empty to use JWKS
SUPABASE_JWT_SECRET=

# Cron job auth (X-Cron-Secret header) and browser origins
CRON_SECRET=
CORS_ORIGINS=http://localhost:5173
